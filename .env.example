# ---- Supabase / PostgreSQL ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for Supabase Storage (evidence/syllabus files). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Postgres connection (Supabase: Project Settings -> Database -> connection string).
# The application switches to the RLS-restricted `obe_app` role inside every request transaction.
DATABASE_URL=postgresql://obe_owner:obe_owner@localhost:5432/obe_dev

# ---- Auth -----------------------------------------------------------------
# Server-only secret used to sign session cookies (min 32 chars).
SESSION_SECRET=

# ---- Gemini (server-only, never exposed to the browser) -------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
